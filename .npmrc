# Faz o npm FALHAR no install quando a versão de Node não satisfaz "engines"
# do package.json, em vez de só imprimir um aviso EBADENGINE.
#
# Sem isto, um pin de Node incompatível com o wrangler passa batido no
# install e só estoura no último passo do deploy, com a mensagem
# "Wrangler requires at least Node.js v22.0.0" — muito mais tarde e muito
# mais longe da causa.
engine-strict=true
