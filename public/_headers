# Cloudflare Workers — política de cache.
# Assets têm hash no nome, então podem ser cacheados para sempre.
# Todo HTML precisa ser revalidado para um deploy novo aparecer na hora.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/grupo
  Cache-Control: public, max-age=0, must-revalidate

/grupo/*
  Cache-Control: public, max-age=0, must-revalidate

# Página de acesso da turma paga: nunca cacheada em intermediários e sempre
# revalidada — o link é entregue individualmente e pode ser trocado a cada turma.
/acesso/*
  Cache-Control: private, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow
