# Cloudflare Pages — política de cache.
# Os assets têm hash no nome, então podem ser cacheados para sempre;
# o HTML precisa ser revalidado para que um deploy novo apareça na hora.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
